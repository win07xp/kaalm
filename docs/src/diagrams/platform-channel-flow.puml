@startuml platform-channel-flow
' A platform channel message after intake: acknowledge, deliver, reply
' through the platform API. The intake checks are the intake figure; the
' rules behind every step are the prose on
' docs/src/gateways/user/platform-adapters.md.
!include _style.puml

actor "Person on\nDiscord or WhatsApp" as user
participant "Platform\n(Discord, Meta)" as plat #FFE4B5
participant "User Gateway\n:8080" as gw #90EE90
participant "Agent Service\n/v1/message" as agent
participant "Platform API" as api #FFE4B5

user -> plat : slash command, or a message
plat -> gw : 1. signed POST /channels/{namespace}/{path}
gw -> gw : 2. intake checks (intake figure)
gw --> plat : 3. acknowledge
gw -> agent : 4. wake if needed, POST /v1/message, up to 4 attempts
agent --> gw : reply envelope, or an error
gw -> api : 5. SendReply, up to 4 attempts per chunk
alt 2xx
  api -> user : the reply, in the chat
else terminal status
  gw -> gw : CallbackRejected, payload dropped
else retries exhausted
  gw -> gw : CallbackRejected, payload dropped
end
@enduml
