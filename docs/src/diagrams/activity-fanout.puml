@startuml activity-fanout
' The controller's activity read: the per-namespace cache, the per-Pod-IP
' fan-out, the merge, then the filter. The rules behind each step are the
' prose on docs/src/gateways/user/activation-and-activity.md.
!include _style.puml

participant "AgentReconciler" as rec #87CEEB
participant "Per-namespace\ncache, 15s" as cache #F5F5F5
participant "Gateway\nPod A" as gwA #90EE90
participant "Gateway\nPod B" as gwB #90EE90
participant "Gateway\nPod C" as gwC #F5F5F5

rec -> cache : 1. activity for namespace X?
alt cache hit
  cache --> rec : cached replicas
else miss or expired
  par one call per gateway Pod IP
    rec -> gwA : 2. GET /v1/activity?namespace=X
    gwA --> rec : replicaStartedAt, agents
  else
    rec -> gwB : 2. GET /v1/activity?namespace=X
    gwB --> rec : replicaStartedAt, agents
  else
    rec ->x gwC : 2. GET /v1/activity?namespace=X
  end
  rec -> cache : 3. store reachable replicas
end
rec -> rec : 4. newest timestamp per agent per source
rec -> rec : 5. apply activitySource
@enduml
