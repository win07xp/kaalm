@startuml traffic-inside
' Traffic classes that stay inside the cluster.
' Source of truth: docs/src/security/model.md
!include _style.puml
skinparam nodesep 30
skinparam ranksep 46
skinparam rectangle {
  roundCorner 4
}
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**Gateway**" as GW #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "**Controller**" as CTRL #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "**Console** (optional)" as CON #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
}
rectangle "a user namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**Agent** Pod" as AG #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}
database "**Kubernetes API server**" as API #back:FFD580;line:7a3f00;text:3a1f00
AG -[#1B5E20,bold]-> GW : 1. LLM, heartbeat, task-complete, tool calls: client certificate
GW -[#1B5E20,bold]-> AG : 2. POST /v1/message: mTLS both ways
GW -[#4A148C,bold]-> CTRL : 3. POST /v1/activate: mTLS, SAN
CTRL -[#4A148C,bold]-> GW : 4. GET /v1/activity, /v1/channels/health: mTLS, SAN
GW -[#7a3f00]-> API : 5. TokenReview, ConfigMap writes, AgentChannel annotation
CTRL <-[#7a3f00]-> API : 6. watches, status, child objects, Events, conversion webhook
CON .[#9E9E9E].> GW : 7. POST /v1/test-chat, GET /v1/spend: mTLS, SAN
CON .[#9E9E9E].> API : 7. reads under its own ServiceAccount
GW -[hidden]down- CTRL
CTRL -[hidden]down- CON
@enduml
