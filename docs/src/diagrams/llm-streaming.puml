@startuml llm-streaming
' An SSE stream relayed through the gateway, with Anthropic event names:
' where usage arrives and where fallback stops being available. The rules
' are the prose on docs/src/gateways/llm/request-handling.md.
!include _style.puml

participant "Agent\ncontainer" as agent
participant "LLM Gateway" as gw #90EE90
participant "Upstream\nprovider" as prov #FFE4B5

agent -> gw : streaming request
gw -> prov : forward

== Before the first chunk: fallback available ==
alt pre-stream failure
  gw -> gw : walk the fallback chain
end
prov --> gw : message_start (input_tokens)
gw --> agent : relay

== First chunk relayed: no fallback ==
loop content chunks
  prov --> gw : chunk
  gw --> agent : relay, unbuffered
end
alt stream completes
  prov --> gw : message_delta (output_tokens)
  gw --> agent : relay
  prov --> gw : message_stop
  gw --> agent : relay
  gw -> gw : settle spend
else upstream fails mid-stream
  gw --> agent : stream ends
  gw -> gw : settle the usage so far
end
@enduml
