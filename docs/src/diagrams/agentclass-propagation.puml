@startuml agentclass-propagation
' What an AgentClass, ModelProvider, or ToolProvider edit does to a
' provisioned Agent, in the order the reconciler decides it. Each row is
' an elseif cascade, laid out left to right. The buckets and their
' examples are the prose on docs/src/controller/change-propagation.md.
!include _style.puml

start
:class or provider spec edit\nre-enqueues every referencing Agent;

partition "bucket 2, then bucket 1" {
  if (stored spec still\nadmitted by the class\nand providers?) then (no)
    :phase=Degraded,\nPod untouched;
    kill
  elseif (Pod spec hash\nchanged?) then (no)
    :children converged\nin place, no restart;
    kill
  elseif (Hibernated?) then (yes)
    :applied on the\nnext wake;
    kill
  else (no)
    :Provisioning: delete the Pod,\ncreate it from the new spec;
    stop
  endif
}
@enduml
