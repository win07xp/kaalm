@startuml validation-enforcement
' Where a validation rule is enforced, and what a violation becomes. This
' draws the mechanism only; the rule-to-outcome mapping is the table on
' docs/src/resources/validation-and-defaulting.md (the source of truth).
!include _style.puml

skinparam ConditionEndStyle hline
skinparam ActivityDiamondFontSize 11
skinparam ActivityFontSize 12
skinparam ArrowFontSize 10
skinparam wrapWidth 150
skinparam nodesep 12

|$agentBg|Developer|
|$ctrlBg|apiserver|
|$storeBg|etcd|
|$ctrlBg|Reconciler|
|$gwBg|status|

|Developer|
start
:kubectl apply;

|$ctrlBg|apiserver|
if (CRD CEL rules) then (violates)
  |$agentBg|Developer|
  :**rejected**\nthe object never exists; <<#FFCDD2>>
  stop
else (passes)
endif

|$storeBg|etcd|
:object stored;

|$ctrlBg|Reconciler|
:reconciler reads\nthe stored object;

switch (reconcile-time rules)
case (reference or\nvalidity failure)
  |$gwBg|status|
  :**Ready=False**\nreason names\nthe rule; <<#FFCDD2>>
  stop
case (class\nmismatch)
  |$gwBg|status|
  :**Agent: phase=Degraded**\nrecovers when\nthe specs align\n**AgentTask: phase=Failed**; <<#FFE0B2>>
  stop
case (advisory)
  |$gwBg|status|
  :**Warning event**\nReady unaffected; <<#FFF8DC>>
  stop
endswitch
@enduml
