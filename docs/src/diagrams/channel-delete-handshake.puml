@startuml channel-delete-handshake
' AgentChannel deletion: the handshake between the reconciler and the
' gateway replicas, one message per numbered step. The rules behind each
' step are the prose on docs/src/controller/finalizers.md.
!include _style.puml

participant "apiserver" as API #FFD580
participant "AgentChannel\nReconciler" as R #87CEEB
participant "Gateway\nreplica 1" as G1 #90EE90
participant "Gateway\nreplica 2" as G2 #90EE90

API -> R : deletionTimestamp set
R -> API : 1. status.phase = Terminating
API -> G1 : watch
API -> G2 : watch
G1 -> G1 : 2. answer 401 on the path
G2 -> G2 : 2. answer 401 on the path
G1 -> API : 3. annotate channel-disconnected
alt annotation seen
  API -> R : 4. confirmed
else 30s since deletionTimestamp
  R -> R : 4. proceed unconfirmed
end
R -> API : 5. delete kaalm-async-* by channel labels
R -> API : 6. remove the finalizer
@enduml
