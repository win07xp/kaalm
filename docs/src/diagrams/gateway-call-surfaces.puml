@startuml gateway-call-surfaces
' The gateway's call surfaces: what flows through the one Deployment, and
' in which direction. The per-surface facts are the table on
' docs/src/gateways/overview.md (the source of truth).
!include _style.puml
left to right direction

rectangle "Channel platforms\n(webhook, Discord, WhatsApp)" as platforms #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "Agent and\nAgentTask Pods" as pods #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
rectangle "**Gateway**\nkaalm-system" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "LLM providers\nand MCP servers" as upstream #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "Controller" as ctrl #back:87CEEB;line:0D47A1;line.bold;text:0a2540

platforms -[#8B4513,bold]-> gw : message (:8080)
gw -[#8B4513,bold]-> pods : deliver, mTLS
gw -[#8B4513,bold]-> platforms : reply
pods -[#4A148C,bold]-> gw : LLM and tool calls (:8443)
gw -[#4A148C,bold]-> upstream : forward, credential injected
pods -[#0D47A1,bold]-> gw : heartbeat, task completion (:8443)
ctrl -[#0D47A1,bold]-> gw : activity, channel health (:8443)

legend bottom
  Brown = User Gateway | Purple = LLM proxy and tool broker | Blue = internal API
endlegend
@enduml
