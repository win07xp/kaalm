@startuml sync-reachability-timeline
' Three clocks from one origin (inbound webhook acceptance), drawn to scale.
' Red is what fires under defaults; grey is unreachable under defaults.
' The arithmetic and the reachability table are the prose on
' docs/src/gateways/api/async-responses.md (the source of truth).
!include _style.puml
scale 10 as 40 pixels

concise "Sync deadline" as SYNC
concise "Agent delivery" as DEL
concise "Wake" as WAKE

@SYNC
0 is "in flight" #90EE90
30 is "**504 sync_deadline_exceeded**\n30s" #FFCDD2
160 is {hidden}

@DEL
0 is "4 attempts" #E6E6FA
31 is "**502 delivery_failed**\n31s to 71s" #F5F5F5
71 is {hidden}
160 is {hidden}

@WAKE
0 is "waiting for Ready" #FFE4B5
120 is "**504 wake_timeout**\n120s" #F5F5F5
160 is {hidden}
@enduml
