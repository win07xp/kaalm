@startuml channel-health-reduction
' How the AgentChannelReconciler reduces per-replica health states into
' PlatformConnected, in the order the rules are tried. Each row is an elseif
' cascade, laid out left to right. What each rule reads and why is the
' prose on docs/src/gateways/user/platform-adapters.md.
!include _style.puml

start
:GET /v1/channels/health\non every gateway Pod IP;

partition "collect" {
  if (any replica reachable?) then (no)
    :keep the existing condition;
    kill
  else (yes)
    :per reachable replica:\nstate and replicaStartedAt;
  endif
}

partition "reduce, in order" {
  if (any replica: success?) then (yes)
    :**True** WebhookReady;
    stop
  elseif (any replica: failure?) then (yes)
    :**False** the newest\nfailure's reason;
    stop
  elseif (one replica up a full window,\nand every replica empty?) then (yes)
    :**Unknown** NoRecentTraffic;
    stop
  else (no)
    :keep the existing condition;
    stop
  endif
}
@enduml
