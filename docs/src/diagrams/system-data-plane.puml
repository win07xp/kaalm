@startuml system-data-plane
' The data plane: every request path, and the one component on all of
' them. Source of truth: docs/src/concepts/system-architecture.md
!include _style.puml
left to right direction

rectangle "Webhook callers\nand channel platforms" as webhooks #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "Callback URLs" as callbacks #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "**Kaalm Gateway**\nkaalm-system" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "User namespaces" as users {
  rectangle "**Agent Pod**" as agentC #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentTask Pod**" as agentTaskC #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Workload Pod**\ngateway-only tier" as workloadC #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}
rectangle "LLM providers" as providers #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "MCP servers" as mcp #back:FFE4B5;line:8B4513;line.bold;text:3a1f00

webhooks -[#8B4513,bold]-> gw : :8080
gw -[#8B4513,bold]-> agentC : /v1/message, mTLS
gw -[#8B4513,bold]-> callbacks : HTTPS
agentC -[#4A148C,bold]-> gw : :8443, mTLS
agentTaskC -[#4A148C,bold]-> gw : :8443, mTLS
workloadC -[#4A148C,bold]-> gw : :8443, bearer token
gw -[#4A148C,bold]-> providers
gw -[#4A148C,bold]-> mcp
@enduml
