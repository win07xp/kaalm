@startuml per-path-auth-enforcement
' One permissive handshake setting on :8443, then per-path client-auth
' decisions in HTTP middleware. The rationale for each branch is the prose on
' docs/src/gateways/listener-tls.md (the source of truth).
!include _style.puml

start
:TLS handshake on :8443\nClientAuth = VerifyClientCertIfGiven;
:Route by path family;

if (path family?) then (dual-mode)
  :/v1/messages, /v1/chat/completions,\n/v1/completions, provider paths,\n/v1/mcp/*;
  if (client cert?) then (yes)
    :**Mode 1: mTLS**\nnamespace from the SAN;
  else (no)
    if (bearer header?) then (yes)
      :**Mode 2: bearer**\nPod precheck, then TokenReview;
    else (no)
      :**401**;
      stop
    endif
  endif
elseif (path family?) then (mTLS only)
  :/v1/agent/heartbeat,\n/v1/task/complete;
  if (client cert?) then (no)
    :**401**;
    stop
  else (yes)
  endif
  if (SAN kind matches the path?) then (no)
    :**403**;
    stop
  else (yes)
  endif
else (controller only)
  :/v1/activity,\n/v1/channels/health;
  if (client cert?) then (no)
    :**401**;
    stop
  else (yes)
  endif
  if (controller SAN?) then (no)
    :**403**;
    stop
  else (yes)
  endif
endif
:Handler;
stop
@enduml
