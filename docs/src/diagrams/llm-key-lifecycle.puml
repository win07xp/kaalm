@startuml llm-key-lifecycle
' The life of an LLM API key: one namespace, two readers, never in an agent.
' Source of truth: docs/src/security/credentials.md
!include _style.puml
skinparam maxMessageSize 300
actor "Platform\nengineer" as PE #FFE4B5
box "a user namespace" #FCFCFC
  participant "**Agent** Pod" as AG #E6E6FA
end box
box "kaalm-system" #F0F4F0
  participant "**Secret**\nanthropic-api-key" as SEC #FFD580
  participant "**Operator**" as OP #87CEEB
  participant "**Gateway**" as GW #90EE90
end box
participant "**LLM provider**" as LLM #FFE4B5
== Stored ==
PE -> SEC : create kaalm-system/anthropic-api-key
== Loaded ==
GW -> SEC : get, then watch, on first use
SEC -> GW : key, held in process memory
OP -> SEC : get on each ModelProvider pass, through the cached client
OP -> LLM : GET /v1/models with the key
== Used ==
AG -> GW : LLM request over mTLS, no credential
GW -> LLM : upstream request, key injected
LLM -> GW : completion
GW -> AG : completion, no credential
== Rotated ==
PE -> SEC : update in place
SEC -> GW : watch event
GW -> GW : refresh in memory, no restart
@enduml
