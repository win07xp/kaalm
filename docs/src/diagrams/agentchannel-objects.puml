@startuml agentchannel-objects
' What the AgentChannelReconciler owns and what it reads. The Role names,
' grants, and bindings are the table on docs/src/security/rbac.md (Per-channel
' Roles); the behavior is the prose on
' docs/src/controller/reconcilers/agentchannel.md.
!include _style.puml
left to right direction

skinparam nodesep 14
skinparam ranksep 70
skinparam rectangle {
  roundCorner 4
}

rectangle "the channel's namespace" as ns #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**AgentChannel**" as chan #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Role and RoleBinding**\ncheck" as check #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Role and RoleBindings**\ncredential" as creds #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Secrets**\nthe channel references" as sec #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "**Agent**\nagentRef" as agent #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentChannels**\nsame path" as sib #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}

rectangle "kaalm-system" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**Gateway Pods**" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "**ConfigMaps**\nkaalm-async-*" as cm #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}

chan -[#4A148C,bold]-> check : owns
chan -[#4A148C,bold]-> creds : owns
check -[#0D47A1]-> sec : get, watch\nevery named Secret
creds -[#0D47A1]-> sec : get, watch\nlabeled Secrets only
chan -[#9E9E9E,dashed]-> agent : reads
chan -[#9E9E9E,dashed]-> sib : reads
gw -[#9E9E9E,dashed]-> chan : health reports
chan -[#B71C1C,dashed]-> cm : deletes expired\nby labels

@enduml
