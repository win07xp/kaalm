@startuml span-tree
' The spans one channel message produces, parent to child.
' Source of truth: docs/src/operations/observability.md
!include _style.puml
skinparam nodesep 16
skinparam ranksep 30
skinparam rectangle {
  roundCorner 4
}
rectangle "channel.receive (server): the webhook or test-chat, User Gateway" as R #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "agent.deliver (client): POST /v1/message with retries, User Gateway" as D #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "the agent's own work: no span, context propagated" as A #back:E6E6FA;line:4A148C;line.dashed;text:2a0a4a
rectangle "llm.request (server): the proxied request, LLM proxy" as LR #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "llm.forward (client): one per provider attempt, LLM proxy" as LF #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "tool.call (server): the governed MCP call, tool broker" as TC #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "tool.forward (client): the upstream half, tool broker" as TF #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
R -[#1B5E20,bold]-> D
D -[#4A148C,dashed]-> A
A -[#4A148C,dashed]-> LR
A -[#4A148C,dashed]-> TC
LR -[#1B5E20,bold]-> LF
TC -[#1B5E20,bold]-> TF
@enduml
