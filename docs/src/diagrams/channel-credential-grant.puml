@startuml channel-credential-grant
' How a channel credential is stored, granted, loaded, and rotated.
' Source of truth: docs/src/security/credentials.md
!include _style.puml
skinparam maxMessageSize 300
actor "Platform\nengineer" as PE #FFE4B5
box "the agent's namespace" #FCFCFC
  participant "**Secret**\ndiscord-bot-credentials" as SEC #FFD580
  participant "**Role**\nkaalm-channel-{name}-creds" as ROLE #F5F5F5
end box
box "kaalm-system" #F0F4F0
  participant "**Operator**" as OP #87CEEB
  participant "**Gateway**" as GW #90EE90
end box
== Stored ==
PE -> SEC : create the Secret in the agent's namespace
== Granted ==
OP -> ROLE : ensure the Role (get, watch, named Secrets) and two RoleBindings
OP -> SEC : get, validate the configured keys
== Loaded ==
GW -> SEC : get, then watch, on the first request that needs it
SEC -> GW : material, held in process memory
== Rotated ==
PE -> SEC : update in place
SEC -> GW : watch event
GW -> GW : refresh in memory, no restart
@enduml
