@startuml ca-rekey-window
' The CA re-key runbook and its finite dual-trust window.
' Source of truth: docs/src/security/tls.md
!include _style.puml
skinparam maxMessageSize 150
actor "Platform\nengineer" as PE #FFE4B5
participant "cert-manager" as CM #F5F5F5
participant "**Bundle**\nkaalm-ca" as TM #F5F5F5
participant "**Agent**" as AG #E6E6FA
participant "**Gateway**" as GW #90EE90
== 1. Keep the old CA trusted ==
PE -> TM : add a copy of the old CA as a second source
TM -> AG : bundle = old CA, old CA copy
== 2. New CA key ==
PE -> CM : delete the kaalm-ca Secret
CM -> CM : re-issue with a new key
TM -> AG : bundle = new CA, old CA copy
AG -> AG : rebuild both pools
TM -> GW : bundle = new CA, old CA copy
GW -> GW : rebuild both pools
== 3. Re-issue the leaves ==
PE -> CM : cmctl renew on every leaf Certificate
CM -> GW : kaalm-gateway-tls under the new key
CM -> AG : {name}-tls under the new key
alt the agent rebuilt both pools
  AG -> GW : LLM request verifies the new gateway leaf
  GW -> AG : POST /v1/message accepted
else the agent missed the bundle change
  AG -[#B71C1C]->x GW : outbound fails: RootCAs holds the old CA only
  GW -[#B71C1C]->x AG : inbound fails: ClientCAs holds the old CA only
end
== 4. Close the window ==
PE -> TM : remove the old CA source
TM -> AG : bundle = new CA only
@enduml
