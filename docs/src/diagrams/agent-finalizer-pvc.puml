@startuml agent-finalizer-pvc
' Agent deletion under the agent finalizer, in the order the reconciler
' runs it. Each row is an elseif cascade, laid out left to right. The
' ordering rule and pvcRetention are the prose on
' docs/src/controller/finalizers.md.
!include _style.puml

start
:deletionTimestamp set,\nfinalizer holds the Agent;
:phase=Terminating,\npreDegradedPhase cleared;

partition "Pod" {
  if (Pod exists?) then (yes)
    :delete, wait for\nthe watch;
    kill
  else (no)
  endif
}

partition "PVC" {
  if (Kaalm-provisioned PVC?) then (no)
  elseif (pvcRetention?) then (Retain)
    :remove the Agent's\nownerRef from the PVC;
  else (Delete)
  endif
  :remove the finalizer;
  :apiserver deletes the Agent;
  stop
}
@enduml
