@startuml signal-topology
' Which component emits which signal, and where it goes.
' Source of truth: docs/src/operations/observability.md
!include _style.puml
skinparam nodesep 16
skinparam ranksep 60
skinparam rectangle {
  roundCorner 4
}
rectangle "**Controller**" as CTRL #back:87CEEB;line:0D47A1;line.bold;text:0a2540
rectangle "**Gateway**" as GW #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "Prometheus scrape" as PROM #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
rectangle "the cluster log pipeline" as LOGS #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
database "Kubernetes API server: Events" as API #back:FFD580;line:7a3f00;text:3a1f00
rectangle "OTLP collector (optional)" as OTLP #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
CTRL -[#0D47A1,bold]-> PROM : :8080/metrics, plain HTTP, every replica
GW -[#1B5E20,bold]-> PROM : :9090/metrics, plain HTTP, every replica
CTRL -[#0D47A1]-> LOGS : stderr, console encoding as shipped
GW -[#1B5E20]-> LOGS : stdout, JSON
CTRL -[#0D47A1]-> API : Events on the six kinds
GW -[#1B5E20]-> API : Warning events on ModelProvider and AgentChannel
GW .[#9E9E9E].> OTLP : spans, OTLP over HTTP
CTRL -[hidden]right- GW
PROM -[hidden]down- LOGS
LOGS -[hidden]down- API
API -[hidden]down- OTLP
@enduml
