@startuml async-callback-delivery
' How an async payload reaches callbackUrl, and the four outcomes the gateway
' records (delivered, rejected, exhausted, invalid). Triggers, signals, and
' rationale are the prose on docs/src/gateways/api/async-responses.md.
!include _style.puml

start
:payload ready;

if (callbackUrl set?) then (yes)
  if (pre-dial checks pass?) then (yes)
    repeat
      :sign and POST;
      if (response?) then (2xx)
        :**delivered**;
        stop
      elseif (401 403 404\n405 410 415) then
        :**rejected**; <<#FFE4B5>>
        break
      else (other)
      endif
    backward :back off 1s, 5s, 25s;
    repeat while (attempts < 4?) is (yes) not (no: **exhausted**)
  else (no)
    :**invalid**; <<#FFE4B5>>
  endif
else (no)
endif

:store for polling;
stop
@enduml
