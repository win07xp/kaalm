@startuml trust-chain
' The Kaalm trust chain: one CA, the namespace its Secret must live in, and the leaves it signs.
' Source of truth: docs/src/security/tls.md
!include _style.puml
skinparam nodesep 18
skinparam ranksep 32
skinparam rectangle {
  roundCorner 4
}
rectangle "cluster-scoped" as band #line:9E9E9E;line.dashed;text:555555 {
  rectangle "**ClusterIssuer** kaalm-selfsigned" as selfsigned #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**ClusterIssuer** kaalm-ca-issuer" as caissuer #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}
rectangle "cluster resource namespace: **cert-manager** by default" as nscm #line:7a3f00;line.dashed;text:3a1f00 {
  rectangle "**Certificate** kaalm-ca: isCA, 5y, key reused on renewal" as cacert #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**Secret** kaalm-ca" as casecret #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "**Bundle** kaalm-ca (trust-manager)" as bundle #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**Certificate** kaalm-gateway-tls" as gwtls #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "**Certificate** kaalm-controller-tls" as ctrltls #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "**Certificate** kaalm-console-tls (console enabled only)" as consoletls #back:F5F5F5;line:9E9E9E;line.dashed;text:555555
}
rectangle "a user namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**Certificate** {name}-tls, per Agent" as agenttls #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Certificate** {taskName}-tls, per AgentTask" as tasktls #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**ConfigMap** kaalm-ca at /var/run/kaalm/ca.crt" as cacm #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
selfsigned -[#9E9E9E,bold]-> cacert : issuerRef
cacert -[#7a3f00,bold]-> casecret : cert-manager writes
casecret -[#B71C1C,bold]-> caissuer : resolved only in that namespace
caissuer -[#1B5E20,bold]-> gwtls : signs
caissuer -[#0D47A1,bold]-> ctrltls
caissuer -[#9E9E9E,dashed]-> consoletls
caissuer -[#4A148C,bold]-> agenttls
caissuer -[#4A148C,bold]-> tasktls
casecret -[#7a3f00]-> bundle : source, read from the trust namespace
bundle -[#7a3f00,bold]-> cacm : projects into every namespace
band -[hidden]down- nscm
bundle -[hidden]down- gwtls
selfsigned -[hidden]right- caissuer
gwtls -[hidden]down- ctrltls
ctrltls -[hidden]down- consoletls
agenttls -[hidden]down- tasktls
tasktls -[hidden]down- cacm
@enduml
