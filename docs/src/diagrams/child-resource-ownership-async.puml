@startuml child-resource-ownership-async
' Async response ConfigMaps live in kaalm-system while their AgentChannel
' lives in a user namespace, so the link is labels, not an ownerRef. The
' reasoning and the cleanup paths are on docs/src/runtime/child-resources.md
' (the source of truth).
!include _style.puml
left to right direction

skinparam nodesep 18
skinparam ranksep 60
skinparam rectangle {
  roundCorner 4
}

rectangle "the channel's namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**AgentChannel**\n{name}" as chan #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}

rectangle "kaalm-system" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**ConfigMap**\nkaalm-async-{requestId}" as cm #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}

chan -[#B71C1C,dashed]-> cm : matched by labels

@enduml
