@startuml credential-map
' Every credential class in one picture: who mints it, who holds it, who
' verifies it, and what it unlocks. The deep dives stay on their own pages:
' llm-key-lifecycle and channel-credential-lifecycle (credentials.md),
' trust-chain (tls.md), workload-auth-modes (llm/workload-identity.md).
' Source of truth: docs/src/security/credentials.md
!include _style.puml

skinparam nodesep 16
skinparam ranksep 34
skinparam rectangle {
  roundCorner 4
}

' ---------- who mints ----------
rectangle "minters" as minters #line:9E9E9E;line.dashed;text:555555 {
  rectangle "platform engineer" as pe #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "cert-manager +\ntrust-manager" as cm #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "kubelet\n(token projection)" as kubelet #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}

' ---------- a user namespace ----------
rectangle "a user namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "Agent / AgentTask Pod" as pod #line:4A148C;line.bold;text:2a0a4a {
    rectangle "leaf certificate {name}-tls\n90d, renewed 30d early" as leaf #back:FFD580;line:7a3f00;line.bold;text:3a1f00
    rectangle "kaalm.gateway +\nkaalm.http_client() /\nhttp_async_client()" as abi #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
    rectangle "framework SDK\napi_key: placeholder" as sdk #back:F5F5F5;line:9E9E9E;text:555555
  }
  rectangle "ConfigMap kaalm-ca\n(public CA bundle)" as cacm #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "tier-1 workload\n(no Agent resource)" as tier1 #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}

' ---------- kaalm-system ----------
rectangle "namespace: kaalm-system" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "Secret\nprovider API key" as pkey #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Secret\ntool credential" as tkey #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "gateway\nverifies SAN + source IP,\nTokenReview, session owner;\nstrips inbound auth headers;\nmints workload-bound\nMCP session ids;\nkeys in process memory only" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
}

' ---------- outside the cluster ----------
rectangle "outside the cluster" as outside #line:8B4513;line.dashed;text:3a1f00 {
  rectangle "LLM provider" as llm #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
  rectangle "MCP tool server" as tool #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
}

' ---------- mint edges ----------
pe -[#7a3f00,bold]-> pkey : creates
pe -[#7a3f00,bold]-> tkey : creates
cm -[#7a3f00,bold]-> leaf : mints per workload
cm -[#7a3f00]-> cacm : projects everywhere
kubelet -[#9E9E9E,bold]-> tier1 : projected SA token,\naudience kaalm-gateway

' ---------- hold and present edges ----------
pkey -[#1B5E20]-> gw : watch,\nnever copied
tkey -[#1B5E20]-> gw : watch,\nnever copied
leaf -[#7a3f00]-> abi : loaded, reloaded\non rotation
abi -[#4A148C,bold]-> gw : mTLS: the SAN\nnames the workload
note on link
  the verified identity unlocks
  provider and tool grants, the
  budget, and the audit name
end note
sdk .[#9E9E9E].> gw : placeholder key:\nstripped
tier1 -[#9E9E9E,bold]-> gw : bearer token, TokenReview:\nnamespace identity only
cacm -[#7a3f00]-> pod : how every caller knows\nit reached the real gateway

' ---------- the only hops with spending power ----------
gw -[#B71C1C,bold]-> llm : injects the API key\n(the only hop it ever travels)
gw -[#B71C1C,bold]-> tool : injects the\ntool credential

legend bottom
  **Read the frames by what they hold.** The only credential material in a team namespace is the
  workload's own identity (its leaf certificate) and the public CA bundle. Everything with spending
  power lives in kaalm-system and crosses exactly one hop, in red, on the gateway's upstream leg.
  ====
  Identity is what unlocks policy: grants, budgets, rate limits, and the audit record all key off the
  verified SAN, or, in the gateway-only tier, off the TokenReview namespace, which is why that tier
  gets namespace-level features only. The ABI factories exist so a framework presents this identity,
  and follows its rotation, with zero handler code.
endlegend

' ---------- layout hints ----------
pe -[hidden]down- cm
cm -[hidden]down- kubelet
pkey -[hidden]down- tkey
llm -[hidden]down- tool
@enduml
