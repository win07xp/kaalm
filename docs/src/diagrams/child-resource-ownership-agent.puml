@startuml child-resource-ownership-agent
' Who owns each Agent child resource, and therefore who collects it. The
' conditions, names, and lifecycle of each child are the table on
' docs/src/runtime/child-resources.md (the source of truth).
!include _style.puml
left to right direction

skinparam nodesep 14
skinparam ranksep 55
skinparam rectangle {
  roundCorner 4
}

rectangle "the Agent's namespace" as ns #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**Agent**\n{name}" as agent #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Pod**\n{name}-xxxxx" as pod #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Service**\n{name}" as svc #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**ServiceAccount**\nagent-{name}" as sa #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**NetworkPolicy**\n{name}" as np #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**PVC**\n{name}-memory" as pvc #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Certificate**\n{name}-tls" as cert #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Secret**\n{name}-tls" as secret #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "**PVC** (pre-existing)\nspec.persistence.existingClaim" as extpvc #back:F5F5F5;line:9E9E9E;line.bold;text:555555
}

agent -[#4A148C,bold]-> pod
agent -[#4A148C,bold]-> svc
agent -[#4A148C,bold]-> sa
agent -[#4A148C,bold]-> np
agent -[#4A148C,bold]-> pvc
agent -[#4A148C,bold]-> cert
cert -[#7a3f00,bold]-> secret
agent -[#9E9E9E,dashed]-> extpvc

@enduml
