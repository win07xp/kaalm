@startuml system-control-plane
' The control plane: the controller, the apiserver, the objects the
' controller materializes, and the two calls that cross between the
' controller and the gateway. Source of truth:
' docs/src/concepts/system-architecture.md
!include _style.puml
left to right direction

rectangle "**Kaalm Controller**\nkaalm-system" as ctrl {
  rectangle "Six reconcilers" as recs #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "Activator :9443" as activator #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "Conversion webhook :9444" as conv #back:87CEEB;line:0D47A1;line.bold;text:0a2540
}
database "Kubernetes API" as apiserver
rectangle "Child objects\nin user namespaces" as users #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
rectangle "**Kaalm Gateway**\nkaalm-system" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b

recs -[#0D47A1,bold]-> apiserver : watch, reconcile
apiserver -[#0D47A1,bold]-> users : create, update
apiserver -[#0D47A1]-> conv : v1alpha1 conversion
gw -[#1B5E20,bold]-> activator : /v1/activate, mTLS
recs -[#0D47A1,bold]-> gw : /v1/activity, /v1/channels/health, mTLS
@enduml
