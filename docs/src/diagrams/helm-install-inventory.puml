@startuml helm-install-inventory
' What the Helm chart installs, where each object lands, and the three prerequisites it does not install.
' Source of truth: docs/src/operations/deployment.md
!include _style.puml
skinparam nodesep 14
skinparam ranksep 26
skinparam rectangle {
  roundCorner 4
}
rectangle "**prerequisites, not installed by the chart**" as prereq #line:B71C1C;line.bold;text:B71C1C {
  rectangle "cert-manager" as pcm #back:F5F5F5;line:B71C1C;line.dashed;text:757575
  rectangle "trust-manager" as ptm #back:F5F5F5;line:B71C1C;line.dashed;text:757575
  rectangle "a CNI that enforces NetworkPolicy" as pcni #back:F5F5F5;line:B71C1C;line.dashed;text:757575
}
rectangle "**cluster-scoped**" as band #line:9E9E9E;line.dashed;text:555555 {
  rectangle "the six CRDs, from crds/" as crds #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "ClusterIssuers kaalm-selfsigned, kaalm-ca-issuer" as issuers #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "ClusterRoles and bindings kaalm-controller, kaalm-gateway" as clusterroles #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "AgentClass standard" as sample #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "Deployment kaalm-controller, 2 replicas, PDB" as dctrl #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "Deployment kaalm-gateway, 2 replicas, PDB" as dgw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "Service kaalm-controller :9443 :9444 :8080" as svcctrl #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "Service kaalm-gateway :8080 :8443 :9090" as svcgw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "ServiceAccounts kaalm-controller, kaalm-gateway" as sas #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Roles and bindings kaalm-controller-leader-election, kaalm-gateway" as roles #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Certificates kaalm-controller-tls, kaalm-gateway-tls" as leafcerts #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Secret kaalm-gateway-session-key" as skey #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
rectangle "**kaalm-system**, only with console.enabled" as nscon #line:9E9E9E;line.dashed;text:555555 {
  rectangle "Deployment kaalm-console, 1 replica" as dcon #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
  rectangle "Service kaalm-console :8443" as svccon #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
  rectangle "ServiceAccount, ClusterRole and binding kaalm-console" as rbcon #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
  rectangle "Certificate kaalm-console-tls" as certcon #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
}
rectangle "cluster resource namespace: **cert-manager** by default" as nscm #line:7a3f00;line.dashed;text:3a1f00 {
  rectangle "Certificate kaalm-ca" as cacert #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Bundle kaalm-ca" as bundle #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
pcm -[hidden]right- ptm
ptm -[hidden]right- pcni
crds -[hidden]right- issuers
clusterroles -[hidden]right- sample
crds -[hidden]down- clusterroles
dctrl -[hidden]right- dgw
svcctrl -[hidden]right- svcgw
sas -[hidden]right- roles
leafcerts -[hidden]right- skey
dctrl -[hidden]down- svcctrl
svcctrl -[hidden]down- sas
sas -[hidden]down- leafcerts
dcon -[hidden]right- svccon
rbcon -[hidden]right- certcon
dcon -[hidden]down- rbcon
cacert -[hidden]right- bundle
pcm -[hidden]down- crds
clusterroles -[hidden]down- dctrl
leafcerts -[hidden]down- dcon
rbcon -[hidden]down- cacert
@enduml
