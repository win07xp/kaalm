@startuml agent-reconcile-pass
' One AgentReconciler pass in the order the code runs it. Each row is an
' elseif cascade, laid out left to right; kill endings are the exits that
' end the pass before the Pod is touched. What each step reads and writes is
' the numbered list on docs/src/controller/reconcilers.md.
!include _style.puml

start
:Agent reconcile;

partition "1 to 4: wake, guards, budget, degrade gate" {
  if (wake=true,\nnot Hibernating?) then (yes)
    :Hibernated: Resuming;\nelse remove, WakeIgnored;
    kill
  elseif (stale wake-trigger,\nno wake request?) then (yes)
    :remove it,\nrequeue;
    kill
  elseif (namespace is\nkaalm-system?) then (yes)
    :Ready=False\nSystemNamespaceForbidden;
    kill
  elseif (AgentClass exists?) then (no)
    :Ready=False\nInvalidReference;
    kill
  else (yes)
  endif
  :Degraded condition\nfrom budget state;
  if (every cross-check\npasses?) then (no)
    :phase=Degraded;
    kill
  elseif (Degraded, all clear?) then (yes)
    :restore\npreDegradedPhase;
    kill
  else (no)
  endif
}

partition "5 to 7: hibernation, gates, Certificate" {
  if (Hibernating or\nHibernated?) then (yes)
    :drive or hold,\npass ends;
    kill
  elseif (class CIDRs valid; image,\nexistingClaim, pull Secrets,\nenv Secrets, handler\nConfigMap present?) then (no)
    :Ready=False; requeue 30s\nfor an unwatched object;
    kill
  elseif (Certificate Ready?) then (no)
    :Pending to Provisioning\nrequeue 5s;
    kill
  else (yes)
  endif
}

partition "8 to 11: children, Pod, activity, status" {
  :SA, Service, PVC,\nNetworkPolicy;
  if (Pod?) then (none)
    :create, Provisioning\n(Resuming if woken);
  elseif (terminal, or spec drift\nwith a free slot?) then (yes)
    :delete, Provisioning\n(Resuming if woken);
  elseif (spec drift,\nno free slot?) then (yes)
    :ReplacementPending,\nold Pod keeps running;
  elseif (crash loop or\nImagePullBackOff?) then (yes)
    :phase=Failed;
  elseif (Ready?) then (yes)
    :Running, or Idle stays;
  else (no)
    :Provisioning\n(Resuming if woken);
  endif
  :Running or Idle:\nevaluate activity;
  :write status if changed;
  stop
}
@enduml
