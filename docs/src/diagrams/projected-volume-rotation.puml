@startuml projected-volume-rotation
' The layout of the projected TLS volume, and what changes on rotation:
' the leaves are symlinks, and only ..data is renamed. The watch this implies
' is on docs/src/runtime/starter-templates.md; the layout is specified on
' docs/src/runtime/contract.md (the source of truth).
!include _style.puml

skinparam nodesep 20
skinparam ranksep 38
skinparam rectangle {
  roundCorner 4
}

rectangle "/var/run/kaalm/" as dir #line:4A148C;line.bold;text:2a0a4a {
  rectangle "**tls.crt**  **tls.key**  **ca.crt**\nsymlinks" as leaves #back:F5F5F5;line:9E9E9E;line.bold;text:555555
  rectangle "**..data**\nsymlink" as data #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "**..2026_07_14_09_00_00.1234**" as old #back:F5F5F5;line:9E9E9E;line.bold;text:555555
  rectangle "**..2026_07_14_11_30_00.5678**" as new #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
}

leaves -[#9E9E9E,bold]-> data : ..data/<key>
data -[#7a3f00,bold]-> old : now
data .[#1B5E20,bold].> new : after rotation

legend bottom
  Rotation writes the new directory first, then renames ..data onto it; no leaf is ever written in place
endlegend
@enduml
