@startuml provider-access-gates
' The gate chain every LLM request passes, in the order the gateway runs
' it (internal/gateway/auth.go, routing.go), and the gate that does not
' exist in the gateway-only tier. Source of truth:
' docs/src/concepts/tenancy-and-tiers.md
!include _style.puml

skinparam ConditionEndStyle hline

start
:LLM request on :8443\nmodel {providerRef}/{modelId};
if (client certificate?) then (yes)
  :namespace, workload, and kind\nfrom the SAN: full lifecycle tier;
else (bearer token)
  :namespace from TokenReview:\ngateway-only tier;
endif
if (Pod at the source IP in that namespace?) then (no)
  :**401** unauthorized; <<#FFCDD2>>
  kill
endif
if (caller has a workload?) then (yes)
  if (**Gate A**: workload and class exist, and\nproviderRef in spec.providers and in\nAgentClass allowedProviders?) then (no)
    :**403** access_denied; <<#FFCDD2>>
    kill
  endif
else (no, gateway-only)
endif
if (providerRef names a ModelProvider?) then (no)
  :**400** invalid_request; <<#FFCDD2>>
  kill
endif
if (**Gate B**: calling namespace in\nModelProvider allowedNamespaces?) then (no)
  :**403** access_denied; <<#FFCDD2>>
  kill
endif
if (**Gate C**: modelId in\nModelProvider models?) then (no)
  :**400** invalid_request; <<#FFCDD2>>
  kill
endif
:budget, rate limit, forward\n(Request handling); <<#90EE90>>
stop
@enduml
