@startuml api-conversion
' Conversion topology: who talks to the apiserver at which version, when the conversion webhook is called, and where its trust comes from.
' Source of truth: docs/src/operations/api-versioning.md
!include _style.puml

skinparam nodesep 18
skinparam ranksep 32
skinparam rectangle {
  roundCorner 4
}

' ---------- clients ----------
rectangle "legacy clients (v1alpha1, deprecated)" as legacy #line:9E9E9E;line.dashed;text:555555 {
  rectangle "kubectl apply\nmanifests still at\napiVersion: kaalm.io/v1alpha1" as kal #back:F5F5F5;line:9E9E9E;line.bold;text:555555
  rectangle "GitOps repo\nstill at v1alpha1" as gitops #back:F5F5F5;line:9E9E9E;line.bold;text:555555
}

rectangle "current clients (v1beta1, the storage version)" as current #line:0D47A1;line.dashed;text:0a2540 {
  rectangle "kubectl\n(preferred version)" as kbeta #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**controller** reconcilers\n**gateway**, **console**\ncompiled against api/v1beta1" as comps #back:87CEEB;line:0D47A1;line.bold;text:0a2540
}

' ---------- the apiserver ----------
rectangle "**apiserver**\nv1alpha1 requests get a\ndeprecation Warning" as api #back:FFD580;line:7a3f00;line.bold;text:3a1f00
rectangle "**etcd**\nevery object stored at v1beta1\n(after migration)" as etcd #back:FFD580;line:7a3f00;line.bold;text:3a1f00

' ---------- kaalm-system ----------
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**controller, every replica**\nconversion listener :9444\nPOST /convert" as conv #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "**Secret** kaalm-controller-tls\ntls.crt, tls.key, ca.crt" as secret #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}

' ---------- trust plumbing ----------
rectangle "cert-manager\n**cainjector**" as cainj #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
rectangle "**CRD** (x6)\nspec.conversion.webhook\nclientConfig.service:\nkaalm-controller:9444 /convert\ncaBundle: the Kaalm CA" as crd #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a

' ---------- edges ----------
kal -[#9E9E9E,bold]-> api : read / write\nat v1alpha1
gitops -[#9E9E9E,bold]-> api
kbeta -[#0D47A1,bold]-> api : at v1beta1:\nno conversion
comps -[#0D47A1,bold]-> api
api -[#7a3f00,bold]-> etcd : encode at the\nstorage version
api -[#9E9E9E,bold]-> conv : ConversionReview\n**v1alpha1 traffic only**
secret -[#7a3f00]-> conv : serves
secret -[#7a3f00]-> cainj : ca.crt
cainj -[#7a3f00,bold]-> crd : injects caBundle
api -[#B71C1C,dashed]-> crd : trusts caBundle,\nverifies the controller

legend bottom
  After storage migration every object in etcd is v1beta1, so reads and writes at v1beta1 are plain
  encode and decode and never leave the apiserver. Only v1alpha1 traffic crosses to the controller, and
  when no controller replica is ready only that traffic fails; nothing stored is touched.
  ====
  Trust runs one way. The apiserver verifies kaalm-controller-tls against the caBundle that cainjector
  keeps in each CRD (annotation cert-manager.io/inject-ca-from: kaalm-system/kaalm-controller-tls).
  The controller verifies nothing about the caller: a ConversionReview carries no authority.
endlegend

' ---------- layout hints ----------
legacy -[hidden]right- current
api -[hidden]right- nssys
nssys -[hidden]right- cainj
@enduml
