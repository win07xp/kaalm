@startuml api-conversion
' Conversion topology: who talks to the apiserver at which version, when the conversion webhook is called, and where its trust comes from.
' Source of truth: docs/src/operations/api-versioning.md
!include _style.puml
skinparam nodesep 18
skinparam ranksep 32
skinparam rectangle {
  roundCorner 4
}
rectangle "legacy clients, v1alpha1" as legacy #line:9E9E9E;line.dashed;text:555555 {
  rectangle "kubectl with v1alpha1 manifests" as kal #back:F5F5F5;line:9E9E9E;line.bold;text:555555
  rectangle "a GitOps repo at v1alpha1" as gitops #back:F5F5F5;line:9E9E9E;line.bold;text:555555
}
rectangle "current clients, v1beta1" as current #line:0D47A1;line.dashed;text:0a2540 {
  rectangle "kubectl, preferred version" as kbeta #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**controller**, **gateway**, **console**" as comps #back:87CEEB;line:0D47A1;line.bold;text:0a2540
}
rectangle "**apiserver**" as api #back:FFD580;line:7a3f00;line.bold;text:3a1f00
rectangle "**etcd**, storage version v1beta1" as etcd #back:FFD580;line:7a3f00;line.bold;text:3a1f00
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**controller**, every replica: POST /convert on :9444" as conv #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "**Secret** kaalm-controller-tls" as secret #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
rectangle "cert-manager **cainjector**" as cainj #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "**CRD** (x6): conversion stanza and caBundle" as crd #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
kal -[#9E9E9E,bold]-> api : at v1alpha1
gitops -[#9E9E9E,bold]-> api
kbeta -[#0D47A1,bold]-> api : at v1beta1
comps -[#0D47A1,bold]-> api
api -[#7a3f00,bold]-> etcd : encode at the storage version
api -[#9E9E9E,bold]-> conv : ConversionReview: requested version differs from the stored one
secret -[#7a3f00]-> conv : serves TLS
secret -[#7a3f00]-> cainj : ca.crt
cainj -[#7a3f00,bold]-> crd : injects caBundle
api -[#9E9E9E,dashed]-> crd : verifies the controller against caBundle
legacy -[hidden]right- current
conv -[hidden]down- secret
etcd -[hidden]down- conv
crd -[hidden]down- cainj
@enduml
