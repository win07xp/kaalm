@startuml gateway-listener-ports
' The single gateway Deployment's four ports, who reaches each, and the
' trust boundary the listener split defends. The per-port facts are the
' Ports table on docs/src/gateways/overview.md (the source of truth).
!include _style.puml
left to right direction

rectangle "**Untrusted**" as untrusted #line:8B4513;line.dashed {
  rectangle "External\nwebhook callers" as ext #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
  rectangle "**Ingress**" as ing #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
}

rectangle "**Cluster-internal (trusted)**" as trusted #line:0D47A1;line.dashed {
  rectangle "Agent and\nAgentTask Pods" as pods #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "Controller" as ctrl #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "kubelet" as kubelet #back:F5F5F5;line:9E9E9E;text:2a0a4a
  rectangle "Prometheus" as prom #back:F5F5F5;line:9E9E9E;text:2a0a4a

  rectangle "**Gateway Deployment** (kaalm-system)" as gw {
    rectangle "**:8080** user listener" as p8080 #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
    rectangle "**:8443** cluster listener" as p8443 #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
    rectangle "**:8081** health" as p8081 #back:F5F5F5;line:9E9E9E;text:2a0a4a
    rectangle "**:9090** metrics" as p9090 #back:F5F5F5;line:9E9E9E;text:2a0a4a
  }
}

ext -[#8B4513,bold]-> ing
ing -[#8B4513,bold]-> p8080 : webhooks
pods -[#4A148C,bold]-> p8443 : mTLS or bearer
ctrl -[#0D47A1,bold]-> p8443 : controller mTLS
kubelet -[#9E9E9E]-> p8081 : probes
prom -[#9E9E9E]-> p9090 : scrape
ing .[#B71C1C,bold]. p8443 : \n\n\n**no route**
@enduml
