@startuml operator-rbac-namespaced
' The operator ServiceAccount's namespaced grants: two Roles in kaalm-system and the Roles it mints in user namespaces.
' Source of truth: docs/src/security/rbac.md
!include _style.puml
skinparam nodesep 14
skinparam ranksep 30
skinparam rectangle {
  roundCorner 4
}
rectangle "**Operator ServiceAccount** kaalm-system/kaalm-controller" as OPSA #back:87CEEB;line:0D47A1;line.bold;text:0a2540
rectangle "**Role** kaalm-controller-leader-election in kaalm-system" as nssys #line:0D47A1;line.dashed;text:0a2540 {
  rectangle "Leases: all verbs" as leases #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "Events: create, patch" as ev #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "ConfigMaps: all verbs" as cm #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}
rectangle "**Role** kaalm-controller-credentials in kaalm-system" as nscred #line:0D47A1;line.dashed;text:0a2540 {
  rectangle "Secrets in kaalm-system: get, list, watch" as syssec #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
rectangle "**Role** kaalm-channel-{name}-creds in the AgentChannel's namespace" as nsuser #line:7a3f00;line.dashed;text:3a1f00 {
  rectangle "Secrets named by the channel: get, watch" as chsec #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
rectangle "**Role** kaalm-agent-{name}-pullsecrets or kaalm-task-{name}-pullsecrets in the workload's namespace" as nspull #line:7a3f00;line.dashed;text:3a1f00 {
  rectangle "Pull Secrets named by the class: get" as pullsec #back:FFD580;line:7a3f00;line.bold;text:3a1f00
}
OPSA -[#0D47A1,bold]-> leases : RoleBinding
OPSA -[#0D47A1,bold]-> syssec : RoleBinding
OPSA .[#7a3f00,bold].> chsec : RoleBinding, per channel
OPSA .[#7a3f00,bold].> pullsec : RoleBinding, per workload
leases -[hidden]down- ev
ev -[hidden]down- cm
cm -[hidden]down- syssec
syssec -[hidden]down- chsec
chsec -[hidden]down- pullsec
@enduml
