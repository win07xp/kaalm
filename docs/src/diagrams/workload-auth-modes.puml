@startuml workload-auth-modes
' How the gateway derives a trustworthy namespace on :8443: the mTLS path,
' the bearer path, and the cross-check both converge on. The Mode 2 checks
' are an elseif cascade, which PlantUML lays out left to right. The rule
' behind each node is the prose on docs/src/gateways/llm/workload-identity.md.
!include _style.puml

start
:request on :8443;
if (client certificate?) then (yes: Mode 1)
  :verified against kaalm-ca\nat the handshake;
  if (one recognized SAN\nwith 5 labels?) then (no)
    :**403** invalid_cert;
    kill
  else (yes)
  endif
  :namespace and workload\nfrom the SAN;
else (no: Mode 2)
  if (bearer token?) then (no)
    :**401** unauthorized;
    kill
  elseif (source Pod is\nKaalm-managed?) then (yes)
    :**401** unauthorized;
    kill
  elseif (token cached?) then (no)
    :TokenReview,\naudience kaalm-gateway;
    if (apiserver reachable?) then (no)
      :**503** internal_unavailable;
      kill
    elseif (authenticated?) then (no)
      :**401** unauthorized;
      kill
    else (yes)
      :cache, TTL from exp;
    endif
  else (yes)
  endif
  :namespace from\nthe username;
endif
if (Pod at the source IP\nin that namespace?) then (no)
  :**401** unauthorized;
  kill
else (yes)
endif
:provider routing;
stop
@enduml
