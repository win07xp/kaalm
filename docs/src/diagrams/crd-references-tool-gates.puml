@startuml crd-references-tool-gates
' Figure 3 of 4: the same two-gate shape for ToolProvider. The class
' allows the tool provider and the workload names it. Source of truth:
' docs/src/concepts/core-concepts.md
!include _style.puml

skinparam nodesep 25
skinparam ranksep 50
skinparam rectangle {
  roundCorner 4
}

rectangle "**Cluster scope** (platform team manages)" as clusterband #line:9E9E9E;line.dashed;text:555555 {
  rectangle "**AgentClass**\nspec.allowedToolProviders" as ac #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**ModelProvider**" as mp #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**ToolProvider**" as tp #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}

rectangle "**Namespace scope** (developer manages)" as nsband #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**Agent**\nspec.tools[].providerRef" as ag #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentTask**\nspec.tools[].providerRef" as at #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentChannel**" as ch #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}

ac -[hidden]right- mp
mp -[hidden]right- tp
ac -[hidden]-> ag
mp -[hidden]-> at
tp -[hidden]-> ch
ag -[hidden]right- at
at -[hidden]right- ch


ac -[#B71C1C,bold]-> tp : **allowedToolProviders**\n//the class permits it//
tp <-[#B71C1C,bold]- ag : **tools[].providerRef**\n//the workload asks//
tp <-[#B71C1C,bold]- at : tools[].providerRef

legend bottom
  Grey = cluster-scoped policy | Purple = namespaced workload
  **Both red edges must pass:** the class allows the provider //and// the workload asks for it
endlegend
@enduml
