@startuml user-webhook-flow
' Delivery and response for one webhook call after intake, one message per
' numbered step. The intake checks are the intake figure; the rules behind
' every step are the prose on docs/src/gateways/user/overview.md.
!include _style.puml

actor "Webhook\ncaller" as caller
participant "User Gateway\n:8080" as gw #90EE90
participant "Controller\nactivator :9443" as ctrl #87CEEB
participant "Agent Service\n/v1/message" as agent
participant "callbackUrl receiver\nor apiserver" as out #FFE4B5

caller -> gw : 1. POST /channels/{namespace}/{path}
gw -> gw : 2. intake checks (intake figure)
alt async mode
  gw -> out : 3. create the placeholder ConfigMap
  gw --> caller : 202 {requestId, channelPath}
end
opt Agent is Hibernated or Hibernating
  gw -> ctrl : 4. POST /v1/activate/{namespace}/{name}
  gw -> agent : poll reachability, up to wakeTimeout
end
gw -> agent : 5. POST /v1/message, up to 4 attempts
agent --> gw : response envelope
alt sync mode
  gw --> caller : 6. 200, within syncDeliveryDeadline
else async mode, callbackUrl set
  gw -> out : 7. signed POST, up to 4 attempts
else async mode, no callback or callback exhausted
  gw -> out : 7. Patch the ConfigMap with the payload
end
@enduml
