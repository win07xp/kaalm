@startuml console-overview
' The optional operator console: how a person reaches it, what it reads, and its one write path through the gateway.
' Source of truth: docs/src/console/overview.md
!include _style.puml
skinparam nodesep 20
skinparam ranksep 36
skinparam rectangle {
  roundCorner 4
}
rectangle "the operator" as priya #back:FFE4B5;line:8B4513;line.bold;text:3a1f00
rectangle "namespace: kaalm-system" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "kaalm-console (optional)" as consolebox #line:0D47A1;line.dashed;text:0a2540 {
    rectangle "HTML pages" as pages #back:87CEEB;line:0D47A1;line.bold;text:0a2540
    rectangle "JSON read API /api/v1" as api #back:87CEEB;line:0D47A1;line.bold;text:0a2540
    rectangle "one data layer: four CRDs and Namespaces, watched" as data #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  }
  rectangle "gateway" as gw #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
}
rectangle "Kubernetes API server" as kube #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
rectangle "a user namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "Agent Pod" as agent #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}
priya -[#8B4513,bold]-> pages : port-forward, session cookie
priya -[#8B4513]-> api : Authorization: Bearer
pages -[#0D47A1]-> data
api -[#0D47A1]-> data
data -[#0D47A1]-> kube : get, list, watch: status and a few spec fields, no Secrets
consolebox -[#9E9E9E]-> kube : TokenReview, SubjectAccessReview
consolebox -[#1B5E20,bold]-> gw : POST /v1/test-chat, GET /v1/spend: mTLS, console SAN
gw -[#1B5E20,bold]-> agent : POST /v1/message
@enduml
