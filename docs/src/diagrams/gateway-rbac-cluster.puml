@startuml gateway-rbac-cluster
' The gateway ServiceAccount's ClusterRole: every grant applies in every namespace.
' Source of truth: docs/src/security/rbac.md
!include _style.puml
skinparam nodesep 14
skinparam ranksep 30
skinparam rectangle {
  roundCorner 4
}
rectangle "**Gateway ServiceAccount** kaalm-system/kaalm-gateway" as GWSA #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
rectangle "**ClusterRole** kaalm-gateway: reach is every namespace" as band #line:B71C1C;line.dashed;text:B71C1C {
  rectangle "tokenreviews: create" as tr #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "Agent, AgentTask, AgentClass, ModelProvider, ToolProvider: get, list, watch" as crds #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "AgentChannel: get, list, watch, patch" as ch #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "Pods: get, list, watch" as pods #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "Services: get" as svc #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "Events: create, patch" as ev #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}
GWSA -[#B71C1C,bold]-> tr : ClusterRoleBinding
tr -[hidden]down- crds
crds -[hidden]down- ch
ch -[hidden]down- pods
pods -[hidden]down- svc
svc -[hidden]down- ev
@enduml
