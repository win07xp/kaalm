@startuml crd-references-providers
' Figure 4 of 4: the references that stay inside the cluster scope. Each
' provider names its credential Secret in kaalm-system, and a ModelProvider
' names other ModelProviders as its fallback tree.
' Source of truth: docs/src/concepts/core-concepts.md
!include _style.puml

skinparam nodesep 25
skinparam ranksep 50
skinparam rectangle {
  roundCorner 4
}

rectangle "**Cluster scope** (platform team manages)" as clusterband #line:9E9E9E;line.dashed;text:555555 {
  rectangle "**AgentClass**" as ac #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**ModelProvider**\nspec.credentialsRef\nspec.fallback" as mp #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
  rectangle "**ToolProvider**\nspec.credentialsRef" as tp #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
}

' The credentials Secret is namespaced and is not a Kaalm CRD, so it sits
' outside both scope partitions.
rectangle "**Secret**\nin kaalm-system" as sec #back:FFD580;line:7a3f00;line.bold;text:3a1f00

rectangle "**Namespace scope** (developer manages)" as nsband #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**Agent**" as ag #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentTask**" as at #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**AgentChannel**" as ch #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}

ac -[hidden]right- mp
mp -[hidden]right- tp
mp -[#9E9E9E,bold]-> mp : **fallback**\n//a tree of ModelProviders//
mp -[#7a3f00,bold]-> sec : credentialsRef
tp -[#7a3f00,bold]-> sec : credentialsRef
ac -[hidden]-> ag
mp -[hidden]-> at
tp -[hidden]-> ch
ag -[hidden]right- at
at -[hidden]right- ch

@enduml
