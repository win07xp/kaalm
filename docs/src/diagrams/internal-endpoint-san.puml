@startuml internal-endpoint-san
' The internal endpoints authorize by SAN: the same CA signs every certificate, so possession is not enough.
' Source of truth: docs/src/security/rbac.md
!include _style.puml
skinparam nodesep 24
skinparam ranksep 44
skinparam rectangle {
  roundCorner 4
}
rectangle "**ClusterIssuer** kaalm-ca-issuer" as CA #back:F5F5F5;line:9E9E9E;line.bold;text:2a0a4a
rectangle "namespace: **kaalm-system**" as nssys #line:1B5E20;line.dashed;text:0b3d0b {
  rectangle "**Gateway** :8443, holds kaalm-gateway-tls" as GW #back:90EE90;line:1B5E20;line.bold;text:0b3d0b
  rectangle "**Controller** :9443, holds kaalm-controller-tls" as CTRL #back:87CEEB;line:0D47A1;line.bold;text:0a2540
  rectangle "**Console** (when enabled), holds kaalm-console-tls" as CON #back:F5F5F5;line:9E9E9E;line.dashed;text:2a0a4a
}
rectangle "a user namespace" as nsuser #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**a compromised Agent**, holds {name}-tls" as AG #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
}
CA -[#9E9E9E,bold]-> GW : issues
CA -[#9E9E9E,bold]-> CTRL : issues
CA -[#9E9E9E,dashed]-> CON : issues
CA -[#9E9E9E,bold]-> AG : issues
GW -[#4A148C,bold]-> CTRL : POST /v1/activate: SAN kaalm-gateway.kaalm-system.svc, allowed
CTRL -[#4A148C,bold]-> GW : GET /v1/activity, GET /v1/channels/health: SAN kaalm-controller.kaalm-system.svc, allowed
CON .[#9E9E9E].> GW : POST /v1/test-chat, GET /v1/spend: SAN kaalm-console.kaalm-system.svc, allowed
AG -[#B71C1C,bold]-> CTRL : POST /v1/activate: SAN {name}.{namespace}.svc.cluster.local, 403
@enduml
