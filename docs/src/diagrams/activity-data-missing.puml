@startuml activity-data-missing
' What the controller does with an activity read, in the order it decides.
' Each row is an elseif cascade, laid out left to right. The rule behind
' each step is the prose on docs/src/controller/hibernation-and-wake.md.
!include _style.puml

start
:activity fan-out for the namespace;

partition "evidence" {
  if (any replica reachable?) then (no)
    :keep the phase, requeue 30s\nGatewayReachable=False;
    kill
  elseif (any replica recorded\nactivity for the Agent?) then (yes)
    :newest timestamp per source,\nthen activitySource;
  elseif (some replica up for\nat least idleTimeout?) then (no)
    :defer, requeue in 30s;
    kill
  else (yes)
    :silence since\nphaseTransitionTime;
  endif
}

partition "transitions" {
  if (Running, idle past\nidleTimeout?) then (yes)
    :Idle;
    stop
  elseif (Idle, real activity newer\nthan lastActivityTime?) then (yes)
    :Running;
    stop
  elseif (Idle, hibernationEnabled,\nsilent past idleTimeout\nplus hibernationDelay?) then (yes)
    :Hibernating;
    stop
  else (no)
    :no change;
    stop
  endif
}
@enduml
