@startuml llm-request-flow
' One LLM call through the gateway, one message per numbered step. The rule
' behind each step is the prose on docs/src/gateways/llm/request-handling.md
' (the source of truth).
!include _style.puml

participant "Agent\ncontainer" as agent
participant "LLM Gateway\n:8443" as gw #90EE90
participant "Informer\ncache" as inf #F5F5F5
participant "Upstream\nprovider" as prov #FFE4B5

agent -> gw : 1. request, qualified model
gw -> inf : 2. authenticate, cross-check the source IP
gw -> gw : 3. path, body cap, parse
gw -> inf : 4. authorize the route
gw -> gw : 5. budget admission
gw -> gw : 6. rate limit
gw -> gw : 7. strip the prefix, fix up,\napply the header contract
gw -> prov : 8. forward (fallback walk on failure)
prov --> gw : response
gw --> agent : 9. relay, buffered or SSE
gw -> gw : 10. read usage, settle spend
@enduml
