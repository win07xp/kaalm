@startuml child-resource-ownership-task
' Who owns each AgentTask child resource. The conditions, names, and
' lifecycle of each child are the table on
' docs/src/runtime/child-resources.md (the source of truth).
!include _style.puml
left to right direction

skinparam nodesep 14
skinparam ranksep 60
skinparam rectangle {
  roundCorner 4
}

rectangle "the AgentTask's namespace" as ns #line:4A148C;line.dashed;text:2a0a4a {
  rectangle "**AgentTask**\n{name}" as task #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Pod**\n{name}-xxxxx" as pod #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**ServiceAccount**\ntask-{name}" as sa #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**NetworkPolicy**\n{name}" as np #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**PVC**\n{name}-workspace" as pvc #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Certificate**\n{name}-tls" as cert #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  rectangle "**Secret**\n{name}-tls" as secret #back:FFD580;line:7a3f00;line.bold;text:3a1f00
  rectangle "only when completion.condition is agentReported" as reported #line:9E9E9E;line.dashed;text:555555 {
    rectangle "**ConfigMap**\n{name}-completion" as cm #back:FFD580;line:7a3f00;line.bold;text:3a1f00
    rectangle "**Role** + **RoleBinding**\nkaalm-task-{name}-completion" as rbac #back:E6E6FA;line:4A148C;line.bold;text:2a0a4a
  }
}

task -[#4A148C,bold]-> pod
task -[#4A148C,bold]-> sa
task -[#4A148C,bold]-> np
task -[#4A148C,bold]-> pvc
task -[#4A148C,bold]-> cert
task -[#4A148C,bold]-> cm
task -[#4A148C,bold]-> rbac
cert -[#7a3f00,bold]-> secret

legend bottom
  **Solid purple** = ownerRef: cascade GC collects it when the AgentTask is deleted
  **Solid brown** = ownerRef to the Certificate, set by cert-manager: collected one hop later
endlegend
@enduml
