@startuml channel-credential-use
' One channel Secret, both directions: the inbound verifier and the outbound callback signature.
' Source of truth: docs/src/security/credentials.md
!include _style.puml
skinparam maxMessageSize 300
participant "**Channel platform**" as EXT #FFE4B5
participant "**Gateway**" as GW #90EE90
participant "**Agent** Pod" as AG #E6E6FA
participant "**callbackUrl receiver**" as CB #FFE4B5
EXT -> GW : inbound webhook POST
GW -> GW : verify with the inbound auth material
GW -> AG : POST /v1/message, no credential
AG -> GW : reply
alt responseMode: async
  GW -> CB : callback POST, signed with the callbackAuth material
else sync
  GW -> EXT : reply in the HTTP response
end
@enduml
