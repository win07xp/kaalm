@startuml fallback-traversal
' One tryWithFallbacks invocation: the pre-checks that cost no attempt slot,
' the one attempt that does, and the depth-first walk of the children.
' Which exit costs what, and where each event fires, is the prose on
' docs/src/gateways/llm/fallback.md (the source of truth).
!include _style.puml

start
:tryWithFallbacks(candidate);

partition "pre-checks: no slot" {
  if (already visited?) then (yes)
    :skip;
    kill
  elseif (statically eligible?) then (no)
    :FallbackIneligible\non the primary;
    kill
  elseif (attemptCount < maxFallbackDepth?) then (no)
    :depth cap;
    kill
  else (yes)
  endif
}

:attemptCount += 1;

partition "the attempt: one slot" {
  if (budget admission?) then (blocked, throttled,\nor failed closed)
    :record the class;
  else (admitted)
    :forward\n(translated if the edge crosses);
    if (response?) then (2xx)
      :return the response;
      stop
    elseif (400, 422,\nother 4xx) then
      :return it to the caller as is;
      stop
    else (fallbackable)
      :record the class,\nfree the boundary slot;
    endif
  endif
}

partition "children, depth-first" {
  while (next in spec.fallback?) is (yes)
    :recurse, attemptCount\nthreaded back out;
    if (result?) then (yes)
      :return the result;
      stop
    else (no)
    endif
  endwhile (none left)
  :no result;
  kill
}
@enduml
