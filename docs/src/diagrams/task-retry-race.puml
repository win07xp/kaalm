@startuml task-retry-race
' An AgentTask retry: the currentPodUID gate closes, the old Pod goes, the
' mailbox is reset, the new Pod is created and stamped in the same pass.
' The rules behind each step are the prose on
' docs/src/controller/task-lifecycle.md.
!include _style.puml

participant "AgentTask\nReconciler" as R #87CEEB
participant "AgentTask\nstatus" as S #F5F5F5
participant "{taskName}-completion\nConfigMap" as CM #FFD580
participant "Gateway" as G #90EE90
participant "Old Pod" as OP
participant "New Pod" as NP

R -> S : 1. retries+1, currentPodUID=""
group gate closed
  R -> OP : 2. delete
  OP ->> G : late /v1/task/complete
  G -->> OP : 409 stale_pod
  R -> CM : 3. data: {}
  R -> NP : 4. create
  R -> S : 5. currentPodUID = new UID
end
NP -> G : /v1/task/complete
G -> CM : 6. write the result
@enduml
