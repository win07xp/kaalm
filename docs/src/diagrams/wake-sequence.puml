@startuml wake-sequence
' Waking a hibernated Agent, one message per numbered step. The rules
' behind each step and the failure arms are the prose and the wake-failures
' figure on docs/src/gateways/user/activation-and-activity.md.
!include _style.puml

participant "User\nGateway" as gw #90EE90
participant "Controller\nactivator :9443\n(any replica)" as ctrl #87CEEB
participant "apiserver" as api #FFD580
participant "Controller\nleader" as leader #87CEEB
participant "Agent\nService" as agent

gw -> gw : 1. cached Agent phase is Hibernated
gw -> ctrl : 2. POST /v1/activate/{namespace}/{name}, mTLS
ctrl -> api : 3. patch kaalm.io/wake=true
ctrl --> gw : 4. 202 Accepted
api -> leader : 5. Agent watch fires
leader -> api : 6. Resuming, then create the Pod
loop every 2s, up to wakeTimeout
  gw -> agent : 7. TCP connect
end
gw -> agent : 8. POST /v1/message
agent --> gw : response envelope
@enduml
